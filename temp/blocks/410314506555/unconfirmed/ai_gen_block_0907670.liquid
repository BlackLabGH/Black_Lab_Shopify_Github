{% doc %}
  @prompt
    Create a reusable two-column hero banner block for use across the site. Left side: dark background panel with an eyebrow/label text, a large bold heading, a body paragraph, and a button. Right side: a product/lifestyle image shown in a light-colored inset frame with padding and rounded corners. Include robust image editing options in the block settings: image picker, image fit (cover, contain, fill, scale-down), focal point/position control, adjustable frame background color, adjustable padding, and adjustable corner radius. Also include color settings for the eyebrow text, heading, body text, background panel, and button (background and text), plus text fields for the eyebrow, heading, body copy, and button label/link., I want the left column with the text to take up 60% and the right column with the image to take up 40% of the screen. , There's an option for button label but I can't see the button., On the image frame, I want an option for "bottom frame space" to make the bottom of the frame thicker than the other sides., I'd like an option to have the block crop the image to only display the parts of it I choose that fit within the selected hero height., Update the "Two-column hero" block, which currently has a fixed pixel height setting (550px), to use responsive height instead. Replace or supplement the single fixed pixel height setting with a desktop height control and a separate mobile height control, so different heights can be set per device, using min-height with viewport-relative or percentage-based sizing rather than one rigid pixel value, so the hero looks properly proportioned on both desktop and mobile screens. Preserve all existing content, image, and color settings on the block., Add a slider to adjust the distribution of width between the two columns., Can you have the desktop minimum height slider be values from 0-100, and have mobile height from 0-120?, Change them back to the previous values please., Can you add a mobile and desktop maximum viewport height?, Can you make the following changes to the default colors for this block when loading the block in (but still leave the option to change them if desired):
    
    Panel Background: 1c1b19
    Eyebrow: c45629
    Heading: faf8f3
    Body Text: e8e3d5
    Button Background: c45629
    Button Text: faf8f3
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-hero-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%}.ai-hero-{{ ai_gen_id }}__layout{display:grid;grid-template-columns:{{ block.settings.text_column_width }}% calc(100% - {{ block.settings.text_column_width }}%);min-height:{{ block.settings.desktop_height }}vh;max-height:{{ block.settings.desktop_max_height }}vh;overflow:hidden;border-radius:{{ block.settings.panel_radius }}px;background:{{ block.settings.panel_background }}}.ai-hero-{{ ai_gen_id }}__content{display:flex;flex-direction:column;justify-content:center;align-items:flex-start;padding:clamp(28px,6vw,76px);color:{{ block.settings.body_color }}}.ai-hero-{{ ai_gen_id }}__eyebrow{margin:0 0 18px;color:{{ block.settings.eyebrow_color }};font-size:12px;font-weight:700;letter-spacing:.14em;line-height:1.3;text-transform:uppercase}.ai-hero-{{ ai_gen_id }}__heading{max-width:620px;margin:0 0 20px;color:{{ block.settings.heading_color }};font-size:clamp(34px,5vw,{{ block.settings.heading_size }}px);font-weight:800;letter-spacing:-.035em;line-height:1.02}.ai-hero-{{ ai_gen_id }}__body{max-width:540px;margin:0 0 30px;color:{{ block.settings.body_color }};font-size:16px;line-height:1.65}.ai-hero-{{ ai_gen_id }}__button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:13px 24px;border-radius:{{ block.settings.button_radius }}px;background:{{ block.settings.button_background }};color:{{ block.settings.button_text_color }};font-size:14px;font-weight:700;line-height:1.2;text-decoration:none}.ai-hero-{{ ai_gen_id }}__button:hover{opacity:.82}.ai-hero-{{ ai_gen_id }}__button:focus-visible{outline:3px solid {{ block.settings.button_text_color }};outline-offset:3px}.ai-hero-{{ ai_gen_id }}__media{display:flex;min-width:0;overflow:hidden;padding:{{ block.settings.image_padding }}px;padding-bottom:calc({{ block.settings.image_padding }}px + {{ block.settings.bottom_frame_space }}px);background:{{ block.settings.frame_background }}}.ai-hero-{{ ai_gen_id }}__image,.ai-hero-{{ ai_gen_id }}__placeholder{display:block;width:100%;min-height:100%;border-radius:{{ block.settings.image_radius }}px;overflow:hidden}.ai-hero-{{ ai_gen_id }}__image{object-fit:{{ block.settings.image_fit }};object-position:{{ block.settings.image_position }}}{% if block.settings.crop_to_hero_height %}.ai-hero-{{ ai_gen_id }}__image{height:100%;min-height:0;object-fit:{{ block.settings.image_fit }}}{% endif %}.ai-hero-{{ ai_gen_id }}__placeholder{position:relative;min-height:280px;background:#e9e7e1}.ai-hero-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%;min-height:280px;color:#77736b}.ai-hero-{{ ai_gen_id }}__empty{position:absolute;right:16px;bottom:14px;left:16px;color:#4d4a45;font-size:13px;text-align:center}@media screen and (max-width:749px){.ai-hero-{{ ai_gen_id }}__layout{grid-template-columns:1fr;min-height:{{ block.settings.mobile_height }}vh;max-height:{{ block.settings.mobile_max_height }}vh}.ai-hero-{{ ai_gen_id }}__media{order:-1;min-height:280px}.ai-hero-{{ ai_gen_id }}__content{padding:38px 28px 42px}}
{% endstyle %}
<div class="ai-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-hero-{{ ai_gen_id }}__layout"><div class="ai-hero-{{ ai_gen_id }}__content">{% if block.settings.eyebrow != blank %}<p class="ai-hero-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}{% if block.settings.heading != blank %}<h2 class="ai-hero-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape | newline_to_br }}</h2>{% endif %}{% if block.settings.body != blank %}<div class="ai-hero-{{ ai_gen_id }}__body">{{ block.settings.body | escape | newline_to_br }}</div>{% endif %}{% if block.settings.button_label != blank %}<a class="ai-hero-{{ ai_gen_id }}__button" href="{% if block.settings.button_link != blank %}{{ block.settings.button_link }}{% else %}#{% endif %}">{{ block.settings.button_label | escape }}</a>{% endif %}</div><div class="ai-hero-{{ ai_gen_id }}__media">{% if block.settings.image != blank %}<img class="ai-hero-{{ ai_gen_id }}__image" src="{{ block.settings.image | image_url: width: 1800 }}" alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">{% else %}<div class="ai-hero-{{ ai_gen_id }}__placeholder">{{ 'hero-apparel-1' | placeholder_svg_tag }}<span class="ai-hero-{{ ai_gen_id }}__empty">Add a product or lifestyle image</span></div>{% endif %}</div></div></div>
{% schema %}{"name":"Two-column hero","settings":[{"type":"header","content":"Content"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Designed for better rest"},{"type":"text","id":"heading","label":"Heading","default":"Comfort that belongs in your home"},{"type":"textarea","id":"body","label":"Body copy","default":"Thoughtfully designed essentials for dogs and the people who love them."},{"type":"text","id":"button_label","label":"Button label","default":"Shop the collection"},{"type":"url","id":"button_link","label":"Button link"},{"type":"header","content":"Image"},{"type":"image_picker","id":"image","label":"Image"},{"type":"checkbox","id":"crop_to_hero_height","label":"Crop image to hero height","default":true},{"type":"select","id":"image_fit","label":"Image fit","options":[{"value":"cover","label":"Cover"},{"value":"contain","label":"Contain"},{"value":"fill","label":"Fill"},{"value":"scale-down","label":"Scale down"}],"default":"cover"},{"type":"select","id":"image_position","label":"Focal point","options":[{"value":"left top","label":"Top left"},{"value":"center top","label":"Top center"},{"value":"right top","label":"Top right"},{"value":"left center","label":"Center left"},{"value":"center center","label":"Center"},{"value":"right center","label":"Center right"},{"value":"left bottom","label":"Bottom left"},{"value":"center bottom","label":"Bottom center"},{"value":"right bottom","label":"Bottom right"}],"default":"center center"},{"type":"color","id":"frame_background","label":"Frame background","default":"#f4f1ea"},{"type":"range","id":"image_padding","label":"Frame padding","min":0,"max":60,"step":5,"unit":"px","default":20},{"type":"range","id":"bottom_frame_space","label":"Bottom frame space","min":0,"max":100,"step":5,"unit":"px","default":0},{"type":"range","id":"image_radius","label":"Image corner radius","min":0,"max":40,"step":2,"unit":"px","default":12},{"type":"header","content":"Responsive layout"},{"type":"range","id":"text_column_width","label":"Text column width","min":30,"max":70,"step":5,"unit":"%","default":60},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"desktop_height","label":"Desktop minimum height","min":40,"max":100,"step":5,"unit":"vh","default":70},{"type":"range","id":"desktop_max_height","label":"Desktop maximum height","min":60,"max":140,"step":5,"unit":"vh","default":100},{"type":"range","id":"mobile_height","label":"Mobile minimum height","min":60,"max":100,"step":5,"unit":"vh","default":85},{"type":"range","id":"mobile_max_height","label":"Mobile maximum height","min":80,"max":140,"step":5,"unit":"vh","default":120},{"type":"range","id":"panel_radius","label":"Panel corner radius","min":0,"max":40,"step":2,"unit":"px","default":16},{"type":"range","id":"heading_size","label":"Heading size","min":36,"max":80,"step":2,"unit":"px","default":58},{"type":"header","content":"Colors"},{"type":"color","id":"panel_background","label":"Panel background","default":"#1c1b19"},{"type":"color","id":"eyebrow_color","label":"Eyebrow","default":"#c45629"},{"type":"color","id":"heading_color","label":"Heading","default":"#faf8f3"},{"type":"color","id":"body_color","label":"Body text","default":"#e8e3d5"},{"type":"color","id":"button_background","label":"Button background","default":"#c45629"},{"type":"color","id":"button_text_color","label":"Button text","default":"#faf8f3"},{"type":"range","id":"button_radius","label":"Button corner radius","min":0,"max":30,"step":2,"unit":"px","default":6}],"presets":[{"name":"Two-column hero"}],"tag":null,"class":"two-column-hero-block"}{% endschema %}