{% doc %}
  @prompt
    Create a two-column hero banner section for a collection page. Left column on a dark near-black background: a small uppercase eyebrow/badge label in an accent color (e.g. "BEST-SELLERS"), a large bold uppercase heading below it, a short paragraph of supporting body copy in a muted light gray, and a solid accent-colored button with label and link beneath. Right column: a full-height image with slightly rounded corners. Stack to a single column on mobile with the image below the text. All text content (eyebrow label, heading, body copy, button label, button link), the image, and the colors (background, accent, text) must be editable theme settings so merchants can edit them live in the theme editor. Make it a reusable, self-contained section with no dynamic sources, metafields, or undefined objects referenced., If you reference the source image, the text column left should be about 66% of the banner and the image should be the right 33%
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-hero-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; margin: 0 auto; }
  .ai-hero-{{ ai_gen_id }}__inner { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); min-height: 520px; background: {{ block.settings.background_color }}; color: {{ block.settings.text_color }}; overflow: hidden; border-radius: {{ block.settings.border_radius }}px; }
  .ai-hero-{{ ai_gen_id }}__content { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: clamp(32px, 6vw, 88px); }
  .ai-hero-{{ ai_gen_id }}__eyebrow { margin: 0 0 22px; color: {{ block.settings.accent_color }}; font-size: 12px; font-weight: 700; letter-spacing: .16em; line-height: 1.2; text-transform: uppercase; }
  .ai-hero-{{ ai_gen_id }}__heading { max-width: 620px; margin: 0; color: {{ block.settings.text_color }}; font-size: clamp(34px, 5vw, 72px); font-weight: 800; letter-spacing: -.035em; line-height: .98; text-transform: uppercase; }
  .ai-hero-{{ ai_gen_id }}__body { max-width: 520px; margin: 24px 0 0; color: {{ block.settings.muted_text_color }}; font-size: 16px; line-height: 1.65; }
  .ai-hero-{{ ai_gen_id }}__button { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; margin-top: 32px; padding: 13px 24px; border: 2px solid {{ block.settings.accent_color }}; border-radius: {{ block.settings.button_radius }}px; background: {{ block.settings.accent_color }}; color: {{ block.settings.button_text_color }}; font-size: 13px; font-weight: 700; letter-spacing: .08em; line-height: 1.2; text-align: center; text-decoration: none; text-transform: uppercase; transition: opacity .2s ease; }
  .ai-hero-{{ ai_gen_id }}__button:hover { opacity: .82; }
  .ai-hero-{{ ai_gen_id }}__button:focus-visible { outline: 3px solid {{ block.settings.text_color }}; outline-offset: 4px; }
  .ai-hero-{{ ai_gen_id }}__media, .ai-hero-{{ ai_gen_id }}__placeholder { min-height: 520px; height: 100%; }
  .ai-hero-{{ ai_gen_id }}__media { display: block; width: 100%; object-fit: cover; }
  .ai-hero-{{ ai_gen_id }}__placeholder { position: relative; display: flex; align-items: center; justify-content: center; background: #252525; color: #bdbdbd; }
  .ai-hero-{{ ai_gen_id }}__placeholder svg { width: 100%; height: 100%; max-width: 420px; max-height: 420px; }
  .ai-hero-{{ ai_gen_id }}__empty-state { position: absolute; padding: 12px 18px; color: #d3d3d3; font-size: 13px; text-align: center; }
  @media screen and (max-width: 749px) { .ai-hero-{{ ai_gen_id }}__inner { grid-template-columns: 1fr; min-height: 0; } .ai-hero-{{ ai_gen_id }}__content { padding: 40px 28px 44px; } .ai-hero-{{ ai_gen_id }}__media, .ai-hero-{{ ai_gen_id }}__placeholder { min-height: 360px; } }
{% endstyle %}
<div class="ai-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-{{ ai_gen_id }}__inner">
    <div class="ai-hero-{{ ai_gen_id }}__content">
      {% if block.settings.eyebrow != blank %}<p class="ai-hero-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
      {% if block.settings.heading != blank %}<h2 class="ai-hero-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
      {% if block.settings.body != blank %}<p class="ai-hero-{{ ai_gen_id }}__body">{{ block.settings.body | escape }}</p>{% endif %}
      {% if block.settings.button_label != blank and block.settings.button_link != blank %}<a class="ai-hero-{{ ai_gen_id }}__button" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>{% endif %}
    </div>
    {% if block.settings.image != blank %}<img class="ai-hero-{{ ai_gen_id }}__media" src="{{ block.settings.image | image_url: width: 1600 }}" alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">{% else %}<div class="ai-hero-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}<span class="ai-hero-{{ ai_gen_id }}__empty-state">Add an image to complete this hero banner.</span></div>{% endif %}
  </div>
</div>
{% schema %}
{"name":"Collection hero banner","settings":[{"type":"header","content":"Content"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"BEST-SELLERS"},{"type":"text","id":"heading","label":"Heading","default":"Built for better days"},{"type":"textarea","id":"body","label":"Body copy","default":"Comfort, durability, and thoughtful design for the dogs who make every day better."},{"type":"text","id":"button_label","label":"Button label","default":"Shop best-sellers"},{"type":"url","id":"button_link","label":"Button link"},{"type":"image_picker","id":"image","label":"Image"},{"type":"header","content":"Colors"},{"type":"color","id":"background_color","label":"Background","default":"#0b0b0b"},{"type":"color","id":"accent_color","label":"Accent","default":"#caa876"},{"type":"color","id":"text_color","label":"Text","default":"#ffffff"},{"type":"color","id":"muted_text_color","label":"Muted text","default":"#d0d0d0"},{"type":"color","id":"button_text_color","label":"Button text","default":"#0b0b0b"},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"border_radius","label":"Corner radius","min":0,"max":32,"step":2,"unit":"px","default":8},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":24,"step":2,"unit":"px","default":2}],"presets":[{"name":"Collection hero banner"}],"tag":null,"class":"collection-hero-banner"}
{% endschema %}