{% doc %}
  @prompt
    Update the existing "Collection hero banner" section/block so its image display settings support a lower minimum height (down to around 150px instead of 300px) and add an image fit setting (cover vs contain) so merchants can control cropping behavior instead of the image stretching. Keep all existing settings (eyebrow label, heading, body copy, button, colors, image frame padding/radius, bottom frame space, desktop width) working exactly as they do now.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-collection-hero-{{ ai_gen_id }} { width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; margin: 0 auto; }
  .ai-collection-hero-{{ ai_gen_id }}__frame { position: relative; min-height: {{ block.settings.image_min_height }}px; padding: {{ block.settings.image_frame_padding }}px; border-radius: {{ block.settings.image_frame_radius }}px; overflow: hidden; background: {{ block.settings.image_frame_color }}; display: flex; align-items: center; }
  .ai-collection-hero-{{ ai_gen_id }}__media, .ai-collection-hero-{{ ai_gen_id }}__placeholder { position: absolute; inset: 0; width: 100%; height: 100%; }
  .ai-collection-hero-{{ ai_gen_id }}__media { object-fit: {{ block.settings.image_fit }}; object-position: center; }
  .ai-collection-hero-{{ ai_gen_id }}__placeholder { display: flex; align-items: center; justify-content: center; color: {{ block.settings.body_color }}; background: {{ block.settings.image_frame_color }}; }
  .ai-collection-hero-{{ ai_gen_id }}__placeholder svg { width: 100%; height: 100%; opacity: 0.25; }
  .ai-collection-hero-{{ ai_gen_id }}__content { position: relative; z-index: 1; width: 100%; max-width: 620px; padding: 40px; color: {{ block.settings.body_color }}; background: {{ block.settings.content_background }}; border-radius: {{ block.settings.content_radius }}px; }
  .ai-collection-hero-{{ ai_gen_id }}__eyebrow { margin: 0 0 10px; color: {{ block.settings.eyebrow_color }}; font-size: .8em; letter-spacing: .12em; text-transform: uppercase; }
  .ai-collection-hero-{{ ai_gen_id }}__heading { margin: 0 0 14px; color: {{ block.settings.heading_color }}; font-size: clamp(2rem, 5vw, 4rem); line-height: 1.05; }
  .ai-collection-hero-{{ ai_gen_id }}__body { margin: 0 0 22px; color: {{ block.settings.body_color }}; line-height: 1.55; }
  .ai-collection-hero-{{ ai_gen_id }}__button { display: inline-flex; align-items: center; justify-content: center; padding: 12px 22px; color: {{ block.settings.button_text_color }}; background: {{ block.settings.button_color }}; border-radius: 999px; text-decoration: none; }
  .ai-collection-hero-{{ ai_gen_id }}__button:focus-visible { outline: 3px solid {{ block.settings.heading_color }}; outline-offset: 3px; }
  .ai-collection-hero-{{ ai_gen_id }}__bottom-space { height: {{ block.settings.bottom_frame_space }}px; }
  @media screen and (max-width: 749px) { .ai-collection-hero-{{ ai_gen_id }}__frame { min-height: {{ block.settings.mobile_min_height }}px; padding: {{ block.settings.image_frame_padding | divided_by: 2 }}px; } .ai-collection-hero-{{ ai_gen_id }}__content { padding: 24px; } }
{% endstyle %}
<div class="ai-collection-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-hero-{{ ai_gen_id }}__frame">
    {% if block.settings.image != blank %}<img class="ai-collection-hero-{{ ai_gen_id }}__media" src="{{ block.settings.image | image_url: width: 2400 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">{% else %}<div class="ai-collection-hero-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}
    <div class="ai-collection-hero-{{ ai_gen_id }}__content">
      {% if block.settings.eyebrow != blank %}<p class="ai-collection-hero-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
      {% if block.settings.heading != blank %}<h2 class="ai-collection-hero-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>{% endif %}
      {% if block.settings.body != blank %}<div class="ai-collection-hero-{{ ai_gen_id }}__body">{{ block.settings.body }}</div>{% endif %}
      {% if block.settings.button_label != blank and block.settings.button_link != blank %}<a class="ai-collection-hero-{{ ai_gen_id }}__button" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>{% endif %}
    </div>
  </div>
  <div class="ai-collection-hero-{{ ai_gen_id }}__bottom-space"></div>
</div>
{% schema %}
{
  "name": "Collection hero banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "New collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for everyday adventures" },
    { "type": "richtext", "id": "body", "label": "Body copy", "default": "<p>Comfortable, durable essentials for life with your best friend.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "image_min_height", "label": "Minimum height", "min": 150, "max": 800, "step": 10, "unit": "px", "default": 300 },
    { "type": "range", "id": "mobile_min_height", "label": "Mobile minimum height", "min": 150, "max": 600, "step": 10, "unit": "px", "default": 260 },
    { "type": "select", "id": "image_fit", "label": "Image fit", "options": [{ "value": "cover", "label": "Cover" }, { "value": "contain", "label": "Contain" }], "default": "cover" },
    { "type": "range", "id": "image_frame_padding", "label": "Image frame padding", "min": 0, "max": 80, "step": 5, "unit": "px", "default": 20 },
    { "type": "range", "id": "image_frame_radius", "label": "Image frame radius", "min": 0, "max": 60, "step": 5, "unit": "px", "default": 10 },
    { "type": "range", "id": "bottom_frame_space", "label": "Bottom frame space", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 20 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "image_frame_color", "label": "Image frame", "default": "#f7f7f7" },
    { "type": "color", "id": "content_background", "label": "Content background", "default": "#ffffff" },
    { "type": "range", "id": "content_radius", "label": "Content radius", "min": 0, "max": 40, "step": 5, "unit": "px", "default": 10 },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#6d52ff" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#373535" },
    { "type": "color", "id": "body_color", "label": "Body", "default": "#373535" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#373535" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Collection hero banner" }],
  "tag": null,
  "class": "collection-hero-banner"
}
{% endschema %}