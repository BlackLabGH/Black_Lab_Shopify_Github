{% doc %}
  @prompt
    Create a sticky add-to-cart bar for product pages, matching my theme’s styling. Fix it to the bottom of the screen on desktop and mobile, and show it only after the main Add to cart button scrolls out of view. Display the product name, selected variant, price, and Add to cart button. Keep it synced with the product’s existing variant picker and add the currently selected variant to the cart. Disable purchasing for unavailable variants. Don’t cover other floating controls. Include editable appearance settings.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-sticky-atc-{{ ai_gen_id }} {
    display: block;
    position: fixed;
    z-index: 40;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    padding: 12px 20px calc(12px + env(safe-area-inset-bottom));
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border-top: 1px solid {{ block.settings.border_color }};
    box-shadow: 0 -5px 20px rgba(0, 0, 0, 0.12);
    transform: translateY(110%);
    visibility: hidden;
    transition: transform 180ms ease, visibility 180ms ease;
  }

  .ai-sticky-atc-{{ ai_gen_id }}.is-visible {
    transform: translateY(0);
    visibility: visible;
  }

  .ai-sticky-atc-{{ ai_gen_id }} .ai-sticky-atc__inner-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .ai-sticky-atc-{{ ai_gen_id }} .ai-sticky-atc__info-{{ ai_gen_id }} { min-width: 0; }
  .ai-sticky-atc-{{ ai_gen_id }} .ai-sticky-atc__title-{{ ai_gen_id }} {
    display: block;
    margin: 0;
    font-weight: 600;
    font-size: 15px;
    color: inherit;
  }
  .ai-sticky-atc-{{ ai_gen_id }} .ai-sticky-atc__variant-{{ ai_gen_id }} {
    display: block;
    margin-top: 3px;
    font-size: 13px;
    opacity: 0.8;
  }
  .ai-sticky-atc-{{ ai_gen_id }} .ai-sticky-atc__actions-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-shrink: 0;
  }
  .ai-sticky-atc-{{ ai_gen_id }} .ai-sticky-atc__price-{{ ai_gen_id }} {
    font-weight: 600;
    white-space: nowrap;
  }
  .ai-sticky-atc-{{ ai_gen_id }} .ai-sticky-atc__button-{{ ai_gen_id }} {
    min-height: 46px;
    padding: 10px 24px;
    border: 1px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.corner_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .ai-sticky-atc-{{ ai_gen_id }} .ai-sticky-atc__button-{{ ai_gen_id }}:focus-visible {
    outline: 3px solid {{ block.settings.text_color }};
    outline-offset: 3px;
  }
  .ai-sticky-atc-{{ ai_gen_id }} .ai-sticky-atc__button-{{ ai_gen_id }}:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  @media screen and (max-width: 749px) {
    .ai-sticky-atc-{{ ai_gen_id }} { padding: 10px 12px calc(10px + env(safe-area-inset-bottom)); }
    .ai-sticky-atc-{{ ai_gen_id }} .ai-sticky-atc__inner-{{ ai_gen_id }} { width: 100%; gap: 10px; }
    .ai-sticky-atc-{{ ai_gen_id }} .ai-sticky-atc__title-{{ ai_gen_id }} { font-size: 13px; }
    .ai-sticky-atc-{{ ai_gen_id }} .ai-sticky-atc__variant-{{ ai_gen_id }} { font-size: 11px; }
    .ai-sticky-atc-{{ ai_gen_id }} .ai-sticky-atc__actions-{{ ai_gen_id }} { gap: 10px; }
    .ai-sticky-atc-{{ ai_gen_id }} .ai-sticky-atc__price-{{ ai_gen_id }} { font-size: 13px; }
    .ai-sticky-atc-{{ ai_gen_id }} .ai-sticky-atc__button-{{ ai_gen_id }} { min-height: 44px; padding: 9px 14px; font-size: 13px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-sticky-atc-{{ ai_gen_id }} { transition: none; }
  }
{% endstyle %}

<sticky-atc-{{ ai_gen_id }}
  class="ai-sticky-atc-{{ ai_gen_id }}"
  data-product-id="{{ product.id }}"
  data-currency-format="{{ shop.money_format | escape }}"
  aria-hidden="true"
  {{ block.shopify_attributes }}
>
  <div class="ai-sticky-atc__inner-{{ ai_gen_id }}">
    <div class="ai-sticky-atc__info-{{ ai_gen_id }}">
      <p class="ai-sticky-atc__title-{{ ai_gen_id }}">{{ product.title | escape }}</p>
      <span class="ai-sticky-atc__variant-{{ ai_gen_id }}"></span>
    </div>
    <div class="ai-sticky-atc__actions-{{ ai_gen_id }}">
      <span class="ai-sticky-atc__price-{{ ai_gen_id }}"></span>
      <button class="ai-sticky-atc__button-{{ ai_gen_id }}" type="button">{{ block.settings.button_label | escape }}</button>
    </div>
  </div>
</sticky-atc-{{ ai_gen_id }}>

<script>
  (function() {
    const tagName = 'sticky-atc-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;

    class StickyAtc extends HTMLElement {
      connectedCallback() {
        this.button = this.querySelector('.ai-sticky-atc__button-{{ ai_gen_id }}');
        this.variantText = this.querySelector('.ai-sticky-atc__variant-{{ ai_gen_id }}');
        this.priceText = this.querySelector('.ai-sticky-atc__price-{{ ai_gen_id }}');
        this.productForm = this.findProductForm();
        this.submitButton = this.productForm && this.productForm.querySelector('button[type="submit"], input[type="submit"]');
        this.variantInput = this.productForm && this.productForm.querySelector('[name="id"]');
        this.productData = {{ product | json }};
        this.observeMainButton();
        this.syncVariant();
        this.onChange = this.syncVariant.bind(this);
        this.onSubmit = this.addToCart.bind(this);
        this.onClickChange = this.syncVariant.bind(this);
        document.addEventListener('change', this.onChange, true);
        document.addEventListener('click', this.onClickChange, true);
        this.button.addEventListener('click', this.onSubmit);
      }

      disconnectedCallback() {
        if (this.observer) this.observer.disconnect();
        document.removeEventListener('change', this.onChange, true);
        document.removeEventListener('click', this.onClickChange, true);
        if (this.button && this.onSubmit) this.button.removeEventListener('click', this.onSubmit);
      }

      findProductForm() {
        const forms = Array.from(document.querySelectorAll('form[action*="/cart/add"]'));
        return forms.find((form) => form.querySelector('[name="id"]') && (!form.querySelector('[name="product-id"]') || form.querySelector('[name="product-id"]').value === String(this.dataset.productId))) || forms.find((form) => form.querySelector('[name="id"]'));
      }

      observeMainButton() {
        if (!this.submitButton || !('IntersectionObserver' in window)) return;
        this.observer = new IntersectionObserver((entries) => {
          const visible = entries.some((entry) => entry.isIntersecting);
          this.setVisibility(!visible);
        }, { threshold: 0 });
        this.observer.observe(this.submitButton);
      }

      setVisibility(show) {
        this.classList.toggle('is-visible', show);
        this.setAttribute('aria-hidden', show ? 'false' : 'true');
      }

      syncVariant() {
        if (!this.productData || !this.variantInput) return;
        const selectedId = Number(this.variantInput.value);
        const variant = this.productData.variants.find((item) => item.id === selectedId);
        if (!variant) return;
        this.variantText.textContent = variant.title === 'Default Title' ? '' : variant.title;
        this.priceText.textContent = this.formatMoney(variant.price);
        this.button.disabled = !variant.available;
        this.button.textContent = variant.available ? '{{ block.settings.button_label | escape }}' : '{{ block.settings.unavailable_label | escape }}';
        this.button.dataset.variantId = variant.id;
      }

      formatMoney(cents) {
        const currency = {{ cart.currency.iso_code | default: shop.currency | json }};
        try {
          return new Intl.NumberFormat(undefined, { style: 'currency', currency: currency }).format(cents / 100);
        } catch (error) {
          return (cents / 100).toFixed(2);
        }
      }

      async addToCart() {
        if (this.button.disabled || !this.button.dataset.variantId) return;
        this.button.disabled = true;
        const originalLabel = '{{ block.settings.button_label | escape }}';
        try {
          const response = await fetch(`${window.Shopify && Shopify.routes ? Shopify.routes.root : '/'}cart/add.js`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ id: Number(this.button.dataset.variantId), quantity: 1 })
          });
          if (!response.ok) throw new Error('Unable to add item');
          await response.json();
          document.dispatchEvent(new CustomEvent('cart:refresh'));
          document.dispatchEvent(new CustomEvent('cart:updated'));
          this.button.textContent = '{{ block.settings.added_label | escape }}';
          window.setTimeout(() => {
            this.syncVariant();
            if (this.button.textContent === '{{ block.settings.added_label | escape }}') this.button.textContent = originalLabel;
          }, 1800);
        } catch (error) {
          this.button.textContent = '{{ block.settings.error_label | escape }}';
          window.setTimeout(() => this.syncVariant(), 1800);
        }
      }
    }

    customElements.define(tagName, StickyAtc);
  })();
</script>

{% schema %}
{
  "name": "Sticky add to cart",
  "settings": [
    { "type": "header", "content": "Appearance" },
    { "type": "range", "id": "desktop_width_percent", "label": "Content width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#373535" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#d3d3d3" },
    { "type": "color", "id": "button_color", "label": "Button background", "default": "#373535" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },
    { "type": "range", "id": "corner_radius", "label": "Button corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 8 },
    { "type": "header", "content": "Button labels" },
    { "type": "text", "id": "button_label", "label": "Add to cart", "default": "Add to cart" },
    { "type": "text", "id": "unavailable_label", "label": "Unavailable", "default": "Unavailable" },
    { "type": "text", "id": "added_label", "label": "Added confirmation", "default": "Added to cart" },
    { "type": "text", "id": "error_label", "label": "Error message", "default": "Please try again" }
  ],
  "presets": [{ "name": "Sticky add to cart" }],
  "tag": null,
  "class": "sticky-atc-block"
}
{% endschema %}