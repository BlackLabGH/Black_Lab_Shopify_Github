{% doc %}
  @prompt
    Paste this into the new block generator:
    
    Create a sticky add-to-cart bar for product pages that matches my existing theme’s colors, typography, and button styling.
    
    Place the bar at the top of the viewport on both desktop and mobile, directly below any visible sticky header and announcement bar. Adjust its top position as those elements appear, disappear, or change height so nothing overlaps.
    
    Keep the bar hidden initially. Show it only after the product’s original, static Add to cart button has been scrolled past and is above the viewport. Do not show it when that button is still below the viewport. Hide the bar again when the shopper scrolls back to the original button.
    
    Display the current product’s name, selected variant options, price, and an Add to cart button. Use the product being viewed, not a manually selected or hardcoded product. Keep the selected variant, price, and availability synchronized with the existing product form, including color swatches and size selections. Clicking the sticky button must add the currently selected variant and quantity to the cart using the theme’s existing cart behavior, without submitting twice. Disable the button and show an appropriate label for sold-out or unavailable variants.
    
    Use a compact, responsive layout that fits mobile screens without horizontal scrolling. Keep the bottom of the screen clear for my AI chatbot icon and 10% off popup. The bar must work from its own section on the product template without needing to be nested inside the existing Product Pages section.
    
    Include editable settings for colors, button label, width, spacing, and separate desktop and mobile top offsets. Preserve accessible labels, keyboard navigation, and visible focus states.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-sticky-cart-{{ ai_gen_id }} { display:block; position:fixed; z-index:40; top:calc(var(--ai-sticky-top-{{ ai_gen_id }}, 0px) + {{ block.settings.desktop_offset }}px); left:0; width:100%; pointer-events:none; }
  .ai-sticky-cart-{{ ai_gen_id }}__inner { box-sizing:border-box; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; margin:0 auto; padding:{{ block.settings.spacing }}px 20px; display:flex; align-items:center; justify-content:space-between; gap:16px; background:{{ block.settings.background_color }}; color:{{ block.settings.text_color }}; border-bottom:1px solid {{ block.settings.border_color }}; box-shadow:0 3px 12px rgba(0,0,0,.12); pointer-events:auto; }
  .ai-sticky-cart-{{ ai_gen_id }}[hidden] { display:none; }
  .ai-sticky-cart-{{ ai_gen_id }}__info { min-width:0; display:flex; align-items:baseline; gap:12px; flex-wrap:wrap; font-family:var(--font-body-family, sans-serif); }
  .ai-sticky-cart-{{ ai_gen_id }}__title { margin:0; font-weight:600; color:{{ block.settings.text_color }}; }
  .ai-sticky-cart-{{ ai_gen_id }}__options { font-size:.9em; }
  .ai-sticky-cart-{{ ai_gen_id }}__price { white-space:nowrap; font-weight:600; }
  .ai-sticky-cart-{{ ai_gen_id }}__button { flex:0 0 auto; padding:10px 18px; border:1px solid {{ block.settings.button_color }}; border-radius:6px; background:{{ block.settings.button_color }}; color:{{ block.settings.button_text_color }}; font:inherit; font-weight:600; cursor:pointer; }
  .ai-sticky-cart-{{ ai_gen_id }}__button:hover:not(:disabled) { filter:brightness(.9); }
  .ai-sticky-cart-{{ ai_gen_id }}__button:focus-visible { outline:3px solid {{ block.settings.focus_color }}; outline-offset:3px; }
  .ai-sticky-cart-{{ ai_gen_id }}__button:disabled { opacity:.65; cursor:not-allowed; }
  @media(max-width:749px) {
    .ai-sticky-cart-{{ ai_gen_id }} { top:calc(var(--ai-sticky-top-{{ ai_gen_id }}, 0px) + {{ block.settings.mobile_offset }}px); }
    .ai-sticky-cart-{{ ai_gen_id }}__inner { width:100%; padding:{{ block.settings.spacing | divided_by: 2 }}px 12px; gap:8px; }
    .ai-sticky-cart-{{ ai_gen_id }}__info { display:block; line-height:1.3; font-size:13px; }
    .ai-sticky-cart-{{ ai_gen_id }}__title { display:block; max-width:54vw; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .ai-sticky-cart-{{ ai_gen_id }}__options { display:block; max-width:54vw; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .ai-sticky-cart-{{ ai_gen_id }}__price { display:block; font-size:12px; }
    .ai-sticky-cart-{{ ai_gen_id }}__button { padding:10px 12px; font-size:13px; }
  }
{% endstyle %}
<sticky-product-cart-{{ ai_gen_id }} class="ai-sticky-cart-{{ ai_gen_id }}" hidden data-product='{{ product | json | escape }}' data-label="{{ block.settings.button_label | escape }}" data-sold-label="{{ block.settings.sold_label | escape }}" data-unavailable-label="{{ block.settings.unavailable_label | escape }}" {{ block.shopify_attributes }}>
  <div class="ai-sticky-cart-{{ ai_gen_id }}__inner">
    <div class="ai-sticky-cart-{{ ai_gen_id }}__info" aria-live="polite">
      <h2 class="ai-sticky-cart-{{ ai_gen_id }}__title">{{ product.title | escape }}</h2>
      <span class="ai-sticky-cart-{{ ai_gen_id }}__options"></span>
      <span class="ai-sticky-cart-{{ ai_gen_id }}__price">{{ product.selected_or_first_available_variant.price | money }}</span>
    </div>
    <button class="ai-sticky-cart-{{ ai_gen_id }}__button" type="button">{{ block.settings.button_label | escape }}</button>
  </div>
</sticky-product-cart-{{ ai_gen_id }}>
<script>
(function(){
  const tag='sticky-product-cart-{{ ai_gen_id }}';
  if(customElements.get(tag)) return;
  class StickyProductCart extends HTMLElement {
    connectedCallback(){
      this.product=JSON.parse(this.dataset.product);
      this.button=this.querySelector('button');
      this.price=this.querySelector('.ai-sticky-cart-{{ ai_gen_id }}__price');
      this.options=this.querySelector('.ai-sticky-cart-{{ ai_gen_id }}__options');
      this.form=document.querySelector('.product__form__wrapper form[action*="/cart/add"], form[action*="/cart/add"]');
      this.staticButton=this.form && this.form.querySelector('button[type="submit"], input[type="submit"]');
      if(!this.form || !this.staticButton) return;
      this.onScroll=()=>this.updateVisibility();
      this.onChange=()=>this.sync();
      this.onClick=()=>{ if(this.button.disabled) return; const submit=this.form.querySelector('button[type="submit"],input[type="submit"]'); if(submit && !submit.disabled) submit.click(); };
      window.addEventListener('scroll',this.onScroll,{passive:true});
      window.addEventListener('resize',this.onScroll);
      this.form.addEventListener('change',this.onChange);
      this.form.addEventListener('input',this.onChange);
      this.button.addEventListener('click',this.onClick);
      this.observer=new MutationObserver(()=>this.sync());
      this.observer.observe(this.form,{subtree:true,childList:true,attributes:true,attributeFilter:['disabled','value','aria-disabled']});
      this.sync(); this.updateVisibility();
    }
    connectedHeaderHeight(){
      let bottom=0;
      document.querySelectorAll('header,[class*="header"],[id*="header"],[class*="announcement"]').forEach(el=>{
        const r=el.getBoundingClientRect(),s=getComputedStyle(el);
        if((s.position==='fixed'||s.position==='sticky')&&r.height>0&&r.bottom>0&&r.top<=2) bottom=Math.max(bottom,r.bottom);
      });
      return bottom;
    }
    updateVisibility(){
      if(!this.staticButton) return;
      const header=this.connectedHeaderHeight();
      this.style.setProperty('--ai-sticky-top-{{ ai_gen_id }}',header+'px');
      const r=this.staticButton.getBoundingClientRect();
      this.hidden=!(r.bottom<=header && r.bottom>0 || r.bottom<=0);
    }
    sync(){
      const id=this.form.querySelector('[name="id"]');
      const variant=this.product.variants.find(v=>String(v.id)===String(id&&id.value));
      const available=!!(variant&&variant.available);
      if(variant){
        this.options.textContent=variant.options.filter(Boolean).join(' / ');
        this.price.textContent=this.formatMoney(variant.price);
      }
      const original=this.form.querySelector('button[type="submit"],input[type="submit"]');
      const unavailable=!variant;
      const sold=!unavailable&&!available;
      this.button.disabled=unavailable||sold||!!(original&&original.disabled);
      this.button.textContent=unavailable?this.dataset.unavailableLabel:(sold?this.dataset.soldLabel:this.dataset.label);
    }
    formatMoney(cents){ return new Intl.NumberFormat(document.documentElement.lang||'en-US',{style:'currency',currency:'{{ cart.currency.iso_code | default: shop.currency }}'}).format(cents/100); }
    disconnectedCallback(){ window.removeEventListener('scroll',this.onScroll); window.removeEventListener('resize',this.onScroll); if(this.form){this.form.removeEventListener('change',this.onChange);this.form.removeEventListener('input',this.onChange);} if(this.observer)this.observer.disconnect(); }
  }
  customElements.define(tag,StickyProductCart);
})();
</script>
{% schema %}
{
  "name": "Sticky add to cart",
  "settings": [
    {"type":"text","id":"button_label","label":"Button label","default":"Add to cart"},
    {"type":"text","id":"sold_label","label":"Sold-out label","default":"Sold out"},
    {"type":"text","id":"unavailable_label","label":"Unavailable label","default":"Unavailable"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"range","id":"desktop_offset","label":"Desktop top offset","min":0,"max":100,"step":5,"unit":"px","default":0},
    {"type":"range","id":"mobile_offset","label":"Mobile top offset","min":0,"max":100,"step":5,"unit":"px","default":0},
    {"type":"range","id":"spacing","label":"Spacing","min":5,"max":30,"step":5,"unit":"px","default":15},
    {"type":"color","id":"background_color","label":"Background","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Text","default":"#373535"},
    {"type":"color","id":"border_color","label":"Border","default":"#d3d3d3"},
    {"type":"color","id":"button_color","label":"Button background","default":"#373535"},
    {"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},
    {"type":"color","id":"focus_color","label":"Focus outline","default":"#004ac7"}
  ],
  "presets": [{"name":"Sticky add to cart"}],
  "tag": null,
  "class": "sticky-product-cart-block"
}
{% endschema %}