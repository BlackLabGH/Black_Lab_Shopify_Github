          }
        },
        "heading_fzQRDQ": {
          "type": "heading",
          "settings": {
            "text": "<p><strong>Free Shipping for Black List Members</strong></p>",
            "size": 60,
            "heading_highlight_type": "italics",
            "highlight_color": "#d43747",
            "highlight_text_color": "#000000"
          }
        },
        "text_mQrc74": {
          "type": "text",
          "settings": {
            "text": "<p>Join the <strong>BLACK LIST</strong> and enjoy exclusive shipping benefits. Your first order ships free, with no minimum purchase required. Plus, every order of $75 or more ships free for members within the contiguous U.S.</p><p>No fees. No points. Just member benefits.</p>",
            "size": 100
          }
        },
        "text_rM3QdR": {
          "type": "text",
          "settings": {
            "text": "<p>Orders are typically processed within 1–2 business days, with delivery generally taking an additional 2–5 business days depending on your location. Expedited shipping options are also available at checkout.</p>",
            "size": 100
          }
        }
      },
