{% doc %}
  @prompt
    Create a new section styled to look like a slim announcement bar (full-width bar, background color setting, text color setting, centered rich text content) intended for the homepage. Include a rich text setting for the message so the merchant can format the text. Add a checkbox setting called "Link message to newsletter" that, when enabled, makes the whole bar clickable so clicking it smoothly scrolls the page down to the email sign-up/newsletter form in the footer section (the newsletter block, id footer-block-3, inside the footer section).
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-bar-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-announcement-bar-{{ ai_gen_id }}__link {
    display: block;
    width: 100%;
    color: inherit;
    text-decoration: none;
    cursor: default;
  }

  .ai-announcement-bar-{{ ai_gen_id }}__link--clickable {
    cursor: pointer;
  }

  .ai-announcement-bar-{{ ai_gen_id }}__content {
    width: 100%;
    min-height: 42px;
    padding: 9px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: {{ settings.type_base_font.family }}, {{ settings.type_base_font.fallback_families }};
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .ai-announcement-bar-{{ ai_gen_id }}__content p {
    margin: 0;
  }

  .ai-announcement-bar-{{ ai_gen_id }}__content a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .ai-announcement-bar-{{ ai_gen_id }}__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -2px;
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar-{{ ai_gen_id }}__content {
      padding: 8px 14px;
      font-size: 0.8125rem;
    }
  }
{% endstyle %}

<announcement-bar-{{ ai_gen_id }}
  class="ai-announcement-bar-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.link_to_newsletter %}
    <a
      class="ai-announcement-bar-{{ ai_gen_id }}__link ai-announcement-bar-{{ ai_gen_id }}__link--clickable"
      href="#footer-block-3"
      aria-label="{{ block.settings.message | strip_html | escape }}"
    >
      <div class="ai-announcement-bar-{{ ai_gen_id }}__content">
        {{ block.settings.message }}
      </div>
    </a>
  {% else %}
    <div class="ai-announcement-bar-{{ ai_gen_id }}__link">
      <div class="ai-announcement-bar-{{ ai_gen_id }}__content">
        {{ block.settings.message }}
      </div>
    </div>
  {% endif %}
</announcement-bar-{{ ai_gen_id }}>

{% if block.settings.link_to_newsletter %}
  <script>
    (function() {
      class AnnouncementBar{{ ai_gen_id }} extends HTMLElement {
        connectedCallback() {
          this.link = this.querySelector('a[href="#footer-block-3"]');
          if (!this.link) return;
          this.link.addEventListener('click', (event) => {
            const target = document.getElementById('footer-block-3');
            if (!target) return;
            event.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            window.history.replaceState(null, '', '#footer-block-3');
          });
        }
      }

      if (!customElements.get('announcement-bar-{{ ai_gen_id }}')) {
        customElements.define('announcement-bar-{{ ai_gen_id }}', AnnouncementBar{{ ai_gen_id }});
      }
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "richtext",
      "id": "message",
      "label": "Message",
      "default": "<p>Join our email list for updates and offers.</p>"
    },
    {
      "type": "checkbox",
      "id": "link_to_newsletter",
      "label": "Link message to newsletter",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#373535"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ],
  "tag": null,
  "class": "announcement-bar-block"
}
{% endschema %}